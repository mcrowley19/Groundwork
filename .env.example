# stage 2 and analyst-query backend: openai (default, needs OPENAI_API_KEY) or codex (Codex CLI, uses your `codex login` ChatGPT credits)
LLM_BACKEND=
OPENAI_API_KEY=
# optional, default gpt-4o-mini
OPENAI_MODEL=
# optional; Mapillary is skipped if unset
MAPILLARY_TOKEN=
# optional, default https://overpass.kumi.systems/api
OVERPASS_URL=
# optional, concurrent OpenAI requests (default 16)
LLM_WORKERS=
# optional, codex backend: model (default: the CLI's), apps per call (default 25), parallel calls (default 4)
CODEX_MODEL=
CODEX_BATCH=
CODEX_WORKERS=
